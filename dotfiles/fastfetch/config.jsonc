{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // nushell-banner style: small green OS logo + three short sentences
  // ("small" auto-detects: apple on macOS, distro logo on linux)
  "logo": {
    "type": "small",
    "color": { "1": "green", "2": "green", "3": "green", "4": "green", "5": "green", "6": "green" },
    "padding": { "top": 0, "left": 1, "right": 2 }
  },

  "display": {
    "separator": ""
  },

  "modules": [
    "break",
    { "type": "os",     "key": " ", "format": "Welcome to {#32}{name} {version}{#}," },
    { "type": "memory", "key": " ", "format": "using {#32}{used}{#} of {total} memory," },
    { "type": "disk",   "key": " ", "folders": "/", "format": "and {#32}{size-used}{#} of {size-total} disk!" }
  ]
}
