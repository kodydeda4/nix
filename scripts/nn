#!/usr/bin/env bash
#=====================================================================================
# nn — nix rebuild
#
# Applies the nix config: rebuilds and switches this machine from this repo.
# On the Mac that's nix-darwin + Home Manager + Homebrew (#mac); on the
# Linux machines it's NixOS + Home Manager (#nixos-laptop, #nixos-desktop).
# Asks for your password (sudo).
#
# Usage:
#   nn                  rebuild and switch
#   nn --show-trace     extra arguments are passed to darwin-rebuild / nixos-rebuild
#=====================================================================================

set -euo pipefail

# the repo this script lives in (scripts/..), so it works wherever it's cloned
NIX_CONFIG_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

if [[ "$(uname)" == "Darwin" ]]; then
	exec sudo darwin-rebuild switch --flake "$NIX_CONFIG_DIR#mac" "$@"
else
	# no #name: nixos-rebuild picks the config named after this machine's hostname
	exec sudo nixos-rebuild switch --flake "$NIX_CONFIG_DIR" "$@"
fi
