#----------------------------------
# ghostty.
#----------------------------------
# theme = dark:Atom One Dark, light:Atom One Light
# theme = dark:coolnight, light:TokyoNight Day
theme = dark:atom-one-dark-oled.conf, light:atom-one-light-thick.conf
# theme = dark:TokyoNight, light:TokyoNight Day

# SF Mono (font-sf-mono cask); Ghostty's built-in Nerd Font symbols fill in the icons
font-family = SF Mono
font-size = 16
# background-opacity = 1
background-opacity = 0.90
# background-opacity = 0.5
# background-blur-radius = 20
# translucent, blurred background; shows wherever nvim leaves the background
# empty, like the file tree. (macos-glass-regular, the native glass, came out
# nearly opaque; macos-glass-clear is the see-through variant.)
background-blur = 25
unfocused-split-opacity = 0.75
confirm-close-surface = false
window-width = 100
window-height = 30
window-padding-x = 8
# top, bottom (px): space under the tmux bar
window-padding-y = 0, 0
window-padding-balance = true

#----------------------------------
# macOS specific features
#----------------------------------
macos-titlebar-style = tabs
# macos-titlebar-style = hidden
macos-option-as-alt = true
window-vsync = true
window-colorspace = display-p3
title = " "

#----------------------------------
# links: cmd+click opens urls
#----------------------------------
link-url = true

#----------------------------------
# keybindings
#----------------------------------
keybind = cmd+shift+equal=increase_font_size:1


# ⌥⌘J / ⌥⌘K -> send ⌥N / ⌥P to nvim (terminals never see ⌘), which adds a cursor
# below/above, like Xcode's Select Column Down/Up. (Not ⌥J / ⌥K: plain ⌥J / ⌥K
# switch tmux tabs.)
keybind = cmd+alt+j=text:\x1bn
keybind = cmd+alt+k=text:\x1bp

# ⌃⌘J / ⌃⌘H / ⌃⌘L -> send ⌥⇧J / ⌥⇧H / ⌥⇧L for nvim's go to definition / back /
# forward (same keys as Zed). Capitals so they don't hit tmux's ⌥H/⌥L.
keybind = ctrl+cmd+j=text:\x1bJ
keybind = ctrl+cmd+h=text:\x1bH
keybind = ctrl+cmd+l=text:\x1bL

# ⌘⇧J -> send ⌥⇧R: nvim reveals the current file in the file tree (like Xcode).
keybind = cmd+shift+j=text:\x1bR

# ⌃M -> send ⌥M: nvim's "Format to Multiple Lines" (like Xcode's ⌃M). Terminals
# normally read ⌃M as Enter; Enter itself is unaffected.
keybind = ctrl+m=text:\x1bm

# ⌘A -> send ⌥⇧A: nvim selects the whole file. (Replaces Ghostty's own
# select-all of the terminal's text.)
keybind = cmd+a=text:\x1bA

# ⌃I -> send ⌥⇧I: nvim formats the selection (or the current line), like Xcode's Re-Indent. (Terminals
# read ⌃I as Tab; the Tab key itself is unaffected.)
keybind = ctrl+i=text:\x1bI

# ⌘⇧O -> send ⌥⇧S: nvim's symbol search, like Xcode's Open Quickly
keybind = cmd+shift+o=text:\x1bS

# ⌘0 -> send ⌥⇧E: nvim shows / hides the file tree, like Xcode's navigator.
# (Replaces Ghostty's default reset-font-size shortcut.)
keybind = cmd+0=text:\x1bE

# ⌘⇧Y -> send ⌥⇧Y: nvim shows / hides a terminal below the editor, like Xcode's debug area
keybind = cmd+shift+y=text:\x1bY

# ⌘> / ⌘< -> send ⌥> / ⌥<: nvim folds / unfolds the whole file / the current scope.
# (⌘< replaces Ghostty's default reload-config shortcut; config reloads still
# happen from the menu bar: Ghostty > Reload Configuration.)
keybind = cmd+shift+period=text:\x1b>
keybind = cmd+shift+comma=text:\x1b<

# ⌃⌘J / ⌃⌘H / ⌃⌘L -> send ⌥⇧J / ⌥⇧H / ⌥⇧L for nvim's go to definition / back /
# forward (same keys as Zed). Capitals so they don't hit tmux's ⌥H/⌥L.
keybind = ctrl+cmd+j=text:\x1bJ
keybind = ctrl+cmd+h=text:\x1bH
keybind = ctrl+cmd+l=text:\x1bL

# ⌘⇧J -> send ⌥⇧R: nvim reveals the current file in the file tree (like Xcode).
keybind = cmd+shift+j=text:\x1bR

# Linux-only extras (ThinkPad), written by home.nix. Missing on the Mac, so skipped.
config-file = ?../ghostty-linux/config
