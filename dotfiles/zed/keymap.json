    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-y": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-cmd-l": "pane::GoForward"
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-i": [
        "vim::Literal",
        [
          "ctrl-i",
          "\t"
        ]
      ]
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-cmd-[": "editor::Fold"
    }
  },
  {
    "context": "ThreadsSidebar && !Editor",
    "bindings": {
      "ctrl-cmd-,": "editor::FoldAll"
    }
  },
  {
    "context": "ThreadsSidebar && !Editor",
    "unbind": {
      "z shift-m": "editor::FoldAll"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-cmd-,": "editor::FoldAll"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "z shift-m": "editor::FoldAll"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-,": "editor::FoldAll"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-k cmd-0": "editor::FoldAll"
    }
  },
  {
    "context": "TextFinder || TextFinder > Picker > Editor || TextFinder > Picker > menu",
    "bindings": {
