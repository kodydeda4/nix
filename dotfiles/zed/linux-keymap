#!/usr/bin/env python3
"""keymap.json (written with the Mac's keys) -> the ThinkPad's Zed keymap, for
home.nix. keyd (hosts/nixos) puts the Mac's modifiers back where they were:
the key where ⌘ is sends Ctrl, the Ctrl-labeled key sends Alt and Super sits
where ⌥ is. So every keystroke moves the same way, and a Mac shortcut is the
same keys under your fingers on the ThinkPad:

  cmd -> ctrl    ctrl -> alt    alt -> super    (shift, fn as is)

Unbinds move too: Zed's Linux defaults are mostly its Mac ones with cmd as
ctrl, so ⌘ ones still hit the right default.

  linux-keymap < keymap.json > linux-keymap.json
"""

import json
import re
import sys

MODIFIERS = {"cmd": "ctrl", "super": "ctrl", "win": "ctrl", "ctrl": "alt", "alt": "super"}
ORDER = ["ctrl", "alt", "shift", "super", "fn"]


def jsonc(text):
	"""Zed's JSON with comments and trailing commas -> plain JSON."""
	text = re.sub(r'("(?:\\.|[^"\\])*")|//[^\n]*|/\*.*?\*/', lambda m: m.group(1) or "", text, flags=re.S)
	return re.sub(r'("(?:\\.|[^"\\])*")|,(\s*[}\]])', lambda m: m.group(1) or m.group(2), text)


def keystroke(stroke):
	"""cmd-shift-o -> ctrl-shift-o (the key itself can be "-": cmd--)."""
	*mods, key = re.split(r"-(?!$)", stroke)
	mods = list(dict.fromkeys(MODIFIERS.get(m, m) for m in mods))
	return "-".join([m for m in ORDER if m in mods] + [m for m in mods if m not in ORDER] + [key])


def keys(chord):
	"""cmd-k cmd-0 -> ctrl-k ctrl-0"""
	return " ".join(keystroke(k) for k in chord.split())


sections = json.loads(jsonc(sys.stdin.read()))
for section in sections:
	for field in ("bindings", "unbind"):
		if field in section:
			section[field] = {keys(k): v for k, v in section[field].items()}
json.dump(sections, sys.stdout, indent=2, ensure_ascii=False)
print()
