#----------------------------------
# ghostty.
#----------------------------------
# theme = dark:Atom One Dark, light:Atom One Light
# theme = dark:coolnight, light:TokyoNight Day
theme = dark:atom-one-dark-oled.conf, light:Atom One Light
# theme = dark:TokyoNight, light:TokyoNight Day

font-family = MesloLGS Nerd Font
font-size = 16
# background-opacity = 1
background-opacity = 0.90
# background-blur-radius = 20
background-blur-radius = 25
unfocused-split-opacity = 0.75
confirm-close-surface = false
window-width = 100
window-height = 30
window-padding-x = 8
# top, bottom (px): space under the tmux bar
window-padding-y = 0, 8
window-padding-balance = true

#----------------------------------
# macOS specific features
#----------------------------------
macos-titlebar-style = tabs
# macos-titlebar-style = hidden
macos-option-as-alt = true
window-vsync = true
window-colorspace = display-p3
title = " "

#----------------------------------
# links: cmd+click opens urls
#----------------------------------
link-url = true

#----------------------------------
# keybindings
#----------------------------------
keybind = cmd+shift+equal=increase_font_size:1


# ⌥⌘J / ⌥⌘K -> send ⌥J / ⌥K, so they reach tmux and nvim (terminals never see ⌘).
# nvim uses them to add a cursor below/above, like Xcode's Select Column Down/Up.
keybind = cmd+alt+j=text:\x1bj
keybind = cmd+alt+k=text:\x1bk

# Linux-only extras (ThinkPad), written by home.nix. Missing on the Mac, so skipped.
config-file = ?../ghostty-linux/config
