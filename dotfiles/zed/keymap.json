    "bindings": {
      "ctrl-cmd-.": "editor::UnfoldAll"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-k cmd-j": "editor::UnfoldAll"
    }
  },
  {
    "context": "TextFinder || TextFinder > Picker > Editor || TextFinder > Picker > menu",
    "bindings": {
