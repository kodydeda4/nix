{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Hyper Key",
                        "manipulators": [
                            {
                                "from": { "key_code": "caps_lock" },
                                "to": [
                                    {
                                        "key_code": "left_command",
                                        "modifiers": ["left_control", "left_option"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "F4 → Application Windows (Exposé)",
                        "manipulators": [
                            {
                                "from": { "key_code": "f4" },
                                "to": [
                                    {
                                        "key_code": "down_arrow",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Print Screen → Screenshot (Cmd+Shift+4)",
                        "manipulators": [
                            {
                                "from": { "key_code": "print_screen" },
                                "to": [
                                    {
                                        "key_code": "4",
                                        "modifiers": ["left_command", "left_shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper + 1 → Open Brave Profile 1",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "5",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] }
                                },
                                "to": [{ "shell_command": "open -na 'Brave Browser' --args --profile-directory='Default'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Open Brave Profile 2",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "2",
                                    "modifiers": { "mandatory": ["control", "option", "command"] }
                                },
                                "to": [{ "shell_command": "open -na 'Brave Browser' --args --profile-directory='Profile 1'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper + letter → open / focus / hide app (app-toggle.sh)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "t",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] }
                                },
                                "to": [{ "shell_command": "~/.config/karabiner/app-toggle.sh com.mitchellh.ghostty" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] }
                                },
                                "to": [{ "shell_command": "~/.config/karabiner/app-toggle.sh app.zen-browser.zen" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "b",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] }
                                },
                                "to": [{ "shell_command": "~/.config/karabiner/app-toggle.sh dev.zed.Zed" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "x",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] }
                                },
                                "to": [{ "shell_command": "~/.config/karabiner/app-toggle.sh com.apple.dt.Xcode" }],
                                "type": "basic"
