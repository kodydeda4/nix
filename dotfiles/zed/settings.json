// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "allow_rewrap": "anywhere",
  "relative_line_numbers": "enabled",
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
    "terminal_init_command": ""
  },
  "show_whitespaces": "selection",
  "format_on_save": "off",
  "indent_guides": {
    "enabled": true
  },
  // real tabs, 2 wide, like nvim (a project's .editorconfig wins)
  "hard_tabs": true,
  "ui_font_family": "SF Pro",
  "agent_ui_font_family": "SF Pro",
  "buffer_font_family": "SF Mono",
  "cli_default_open_behavior": "new_window",
  // ⌘W with no tabs left closes the window, like the Mac, on Linux too
  "when_closing_with_no_tabs": "close_window",
  "project_panel": {
    "dock": "left",
    // Zed's default is 240
    "default_width": 400
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "auto_install_extensions": {
    "material-icon-theme": true,
    "one-dark-darkened": true,
    "tokyo-night": true
  },
  "markdown_preview": {
    "font_family": "SF Pro",
    "code_font_family": "SF Mono"
  },
  "terminal": {
    // SF Mono like Ghostty; Nerd Font icons (prompt, eza...) from Meslo
    // (nix: nerd-fonts.meslo-lg), as Ghostty's built-in ones aren't in Zed
    "font_family": "SF Mono",
    "font_fallbacks": ["MesloLGS Nerd Font Mono"]
  },
  "tab_size": 2,
  "languages": {
    // Formatters are nvim's (conform.lua), through ./format (zed-format on
    // PATH: scripts/, so the same on the Mac and Linux): same tools,
    // arguments and config lookup, tabs 2 wide (nix: alejandra has none)
    "Swift": {
      // Swift is colored only by semantic tokens, which xcode/sourcekit.lua
      // computes the way nvim colors Swift (see there)
      "semantic_tokens": "full",
      "formatter": {"external": {"command": "zed-format", "arguments": ["swiftformat", "{buffer_path}"]}}
    },
    "Rust": { "formatter": [{"external": {"command": "zed-format", "arguments": ["rustfmt", "{buffer_path}"]}}, {"external": {"command": "zed-format", "arguments": ["dx_rsx", "{buffer_path}"]}}] },
    "Nix": { "formatter": {"external": {"command": "zed-format", "arguments": ["alejandra", "{buffer_path}"]}} },
    "Lua": { "formatter": {"external": {"command": "zed-format", "arguments": ["stylua", "{buffer_path}"]}} },
    "Shell Script": { "formatter": {"external": {"command": "zed-format", "arguments": ["shfmt", "{buffer_path}"]}} },
    "JavaScript": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "TypeScript": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "TSX": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "Svelte": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "JSON": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "JSONC": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "CSS": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "SCSS": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "HTML": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "Markdown": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} },
    "YAML": { "formatter": {"external": {"command": "zed-format", "arguments": ["prettier", "{buffer_path}"]}} }
  },
  "lsp": {
    "sourcekit-lsp": {
      "binary": {
        "path": "/run/current-system/sw/bin/nvim",
        "arguments": ["--clean", "--headless", "-l", "/Users/kody/.config/zed/xcode/sourcekit.lua"]
      }
    }
  },
  "global_lsp_settings": {
    // generated by xcode/build.py: sourcekit.lua's token types (nvim's colors)
    "semantic_token_rules": [
      {"token_type": "xc_attribute", "token_modifiers": ["bold", "strike"], "style": ["xc_attribute"], "font_weight": "bold", "strikethrough": true},
      {"token_type": "xc_attribute", "token_modifiers": ["strike"], "style": ["xc_attribute"], "strikethrough": true},
