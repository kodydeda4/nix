#!/usr/bin/env bash
#=====================================================================================
# scripts — list these scripts
#
# Lists the commands in this folder and what each one does. The tagline comes
# from the first line of each script's header ("# name — tagline", like above).
#
# Usage:
#   scripts             list every script and what it does
#   scripts <name>      show the full header (description + usage) for one script
#=====================================================================================

set -euo pipefail

# the folder this script lives in, so it works wherever the repo is cloned
SCRIPTS_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Prints the header block of a script: the lines between the two ==== rulers,
# without the leading "# ".
header() {
	awk '/^#=+$/ { if (inside) exit; inside = 1; next }
	     inside  { sub(/^# ?/, ""); print }' "$1"
}

if [[ $# -gt 0 ]]; then
	file="$SCRIPTS_DIR/$1"
	[[ -f "$file" ]] || file="$SCRIPTS_DIR/$1.zsh"
	if [[ ! -f "$file" ]]; then
		echo "scripts: no script named '$1'" >&2
		exit 1
	fi
	header "$file"
	exit 0
fi

# Two columns like `lsd -l`: name, then the tagline. Skips this script itself.
for file in "$SCRIPTS_DIR"/*; do
	[[ -f "$file" ]] || continue
	name="$(basename "$file" .zsh)"
	[[ "$name" == "scripts" ]] && continue
	# tagline from the header's first line: "# name — tagline"
	summary="$(header "$file" | head -1 | sed -n 's/^[^ ]* — //p')"
	printf '\033[1;32m%-12s\033[0m \033[38;5;229m%s\033[0m\n' "$name" "$summary"
done
