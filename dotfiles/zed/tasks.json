// Zed tasks
//
// Xcode build / run / stop / scheme / device for iOS projects; they call scripts/xc and are
// bound to ⌘B / ⌘R / ⌘. / ⌃T / ⌃G in keymap.json.
//
// For information on tasks, see https://zed.dev/docs/tasks
[
  {
    // Space l g (keymap.json), like nvim's lazygit.nvim: a tab in the editor
    // area that closes when you quit lazygit
    "label": "lazygit",
    "command": "lazygit",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "always"
  },
  {
    "label": "Xcode: Build",
    "command": "xc build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Xcode: Run",
    "command": "xc run",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "Xcode: Stop",
    "command": "xc stop",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Xcode: Choose Device",
    "command": "xc device",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success"
  },
  {
    "label": "Xcode: Choose Scheme",
    "command": "xc scheme",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success"
  }
]
