    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-cmd-l": "pane::GoForward"
    }
  },
  {
    "context": "vim_mode == literal",
    "bindings": {
      "ctrl-i": [
        "vim::Literal",
        [
          "ctrl-i",
          "\t"
        ]
      ]
    }
