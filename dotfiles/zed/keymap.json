  },
  {
    "context": "Editor && !agent_diff && !AgentPanel",
    "unbind": {
      "cmd-shift-y": "git::UnstageAndNext"
    }
  },
  {
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "unbind": {
