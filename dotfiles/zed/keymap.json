    }
  },
  {
    "context": "ThreadsSidebar && !Editor",
    "unbind": {
      "z shift-r": "editor::UnfoldAll"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-cmd-.": "editor::UnfoldAll"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "z shift-r": "editor::UnfoldAll"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-cmd-.": "editor::UnfoldAll"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-k cmd-j": "editor::UnfoldAll"
    }
  },
  {
    "context": "TextFinder || TextFinder > Picker > Editor || TextFinder > Picker > menu",
    "bindings": {
      "cmd->": "text_finder::Unfold"
    }
  },
  {
    "context": "TextFinder || TextFinder > Picker > Editor || TextFinder > Picker > menu",
    "unbind": {
      "alt-cmd-]": "text_finder::Unfold"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "cmd->": "editor::UnfoldLines"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "z o": "editor::UnfoldLines"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd->": "editor::UnfoldLines"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-cmd-]": "editor::UnfoldLines"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "cmd-<": "editor::Fold"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "z c": "editor::Fold"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-cmd-j": "editor::GoToDefinition"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "g d": "editor::GoToDefinition"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-cmd-h": "pane::GoBack"
    }
  },
  {
    "context": "VimControl && !menu",
    "unbind": {
      "ctrl-o": "pane::GoBack"
    }
  },
  {
    "unbind": {
      "ctrl-cmd-l": "lsp_tool::ToggleMenu"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-o": "projects::OpenRecent"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-r": "projects::OpenRecent"
    }
  },
  {
    // Like Xcode's Select Column Down/Up (also ⌥⌘J/K in nvim): add a cursor
    // on the line below/above. Works in vim mode too.
    "context": "Editor",
    "bindings": {
      "alt-cmd-j": "editor::AddSelectionBelow",
      "alt-cmd-k": "editor::AddSelectionAbove"
    }
  },
  {
    // Xcode-style build / run / stop / scheme / device (tasks.json -> scripts/xc). Bound in
    // both contexts so they beat Editor defaults; ⌃T / ⌃G stay out of the
    // terminal so fzf's ⌃T still works there.
    "context": "Workspace",
    "bindings": {
      "cmd-b": ["task::Spawn", { "task_name": "Xcode: Build" }],
      "cmd-r": ["task::Spawn", { "task_name": "Xcode: Run" }],
      "cmd-.": ["task::Spawn", { "task_name": "Xcode: Stop" }]
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-b": ["task::Spawn", { "task_name": "Xcode: Build" }],
      "cmd-r": ["task::Spawn", { "task_name": "Xcode: Run" }],
      "cmd-.": ["task::Spawn", { "task_name": "Xcode: Stop" }],
      "ctrl-t": ["task::Spawn", { "task_name": "Xcode: Choose Scheme" }],
      "ctrl-g": ["task::Spawn", { "task_name": "Xcode: Choose Device" }]
    }
  },
  {
    // Ctrl+J / Ctrl+K: next / previous tab, like in nvim. Editor only, so the
    // terminal keeps them.
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-j": "pane::ActivateNextItem",
      "ctrl-k": "pane::ActivatePreviousItem"
    }
  }
]
